# Backend ParkyFilms - ejemplo para ejecución fuera de Docker
# (Con Docker Compose se inyecta todo desde el `.env` de la raíz)
NODE_ENV=development
PORT=3000
DB_HOST=localhost
DB_PORT=5433
DB_NAME=parkyfilms
DB_USER=postgres
DB_PASSWORD=cambia_esta_clave_en_local
JWT_SECRET=cambia_jwt_secret_local_minimo_32_chars_123456
JWT_EXPIRES_IN=2h
SESSION_SECRET=cambia_session_secret_local_minimo_32_chars_123456
FRONTEND_URL=http://localhost:8080
BACKEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:8080
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
EMAIL_SERVICE=
EMAIL_USER=
EMAIL_PASSWORD=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
