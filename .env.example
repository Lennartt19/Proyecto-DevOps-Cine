# ============================================================
# ParkyFilms - Plantilla de variables de entorno (LOCAL con Docker)
# Copiar a `.env` y ajustar valores:  cp .env.example .env
# NUNCA subir el `.env` real a git (tiene secretos).
# ============================================================

# ---------- Proyecto / Compose ----------
COMPOSE_PROJECT_NAME=parkyfilms
TZ=America/Lima

# ---------- Base de datos (servicio `db`) ----------
POSTGRES_DB=parkyfilms
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambia_esta_clave_en_local
DB_PORT_HOST=5433
# Nombre del volumen (persistencia local)
PGDATA_VOLUME=pgdata

# ---------- Backend (servicio `backend`) ----------
BACKEND_PORT_HOST=3000
NODE_ENV=development
PORT=3000

# DB_SSL: true en producción real (Postgres gestionado con TLS: Railway, Azure).
# false SOLO para prod LOCAL (el Postgres del compose no tiene certificados).
DB_SSL=false
# COOKIE_SECURE: true en producción real (detrás de HTTPS).
# false SOLO para prod LOCAL por http://localhost (el navegador tira cookies secure sin TLS).
COOKIE_SECURE=false

# Conexión a la BD *dentro* de la red Docker (NO localhost).
# Opción A (recomendada en Compose): variables individuales
DB_HOST=db
DB_PORT=5432
DB_NAME=${POSTGRES_DB}
DB_USER=${POSTGRES_USER}
DB_PASSWORD=${POSTGRES_PASSWORD}
# Opción B (alternativa estilo Railway, opcional):
# DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# Seguridad (OBLIGATORIAS en prod; en local usa valores de ejemplo)
JWT_SECRET=cambia_jwt_secret_local_minimo_32_chars_123456
JWT_EXPIRES_IN=2h
SESSION_SECRET=cambia_session_secret_local_minimo_32_chars_123456

# URLs públicas en LOCAL (el navegador las usa para redirigir)
FRONTEND_URL=http://localhost:8080
BACKEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:8080
# Orígenes extra separados por coma (opcional, ej. para ng serve directo)
CORS_EXTRA_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# ---------- Frontend (servicio `frontend`) ----------
FRONTEND_PORT_HOST=8080
# URL que el NAVEGADOR usará para llamar a la API (debe ser alcanzable desde tu PC, no desde dentro de Docker)
API_URL=http://localhost:3000/api
APP_URL=http://localhost:8080

# ---------- OAuth (opcional en local; si se dejan vacíos se desactiva) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---------- Email / PayPal (opcionales en local) ----------
EMAIL_SERVICE=
EMAIL_USER=
EMAIL_PASSWORD=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# ---------- EmailJS (frontend, clave pública visible en index.html) ----------
# Actualmente hardcodeada en src/index.html. Mover a env de build cuando se pueda.
EMAILJS_PUBLIC_KEY=A7_9fq0R5JbnCvgtv
